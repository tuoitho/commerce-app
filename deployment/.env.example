# Ports exposed on host
FRONTEND_PORT=15173
ADMIN_PORT=15174
BACKEND_PORT=18080
POSTGRES_PORT=5432
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_UDP_PORT=8189

# PostgreSQL
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_DB=commercesdd

# Backend application & JWT
APP_ENV=production
LOG_LEVEL=info
JWT_ACCESS_SECRET=change-me-to-a-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=999999h
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false

# Default bootstrap accounts (created idempotently on first startup)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=Admin123456@
CUSTOMER_BOOTSTRAP_EMAIL=customer@example.com
CUSTOMER_BOOTSTRAP_PASSWORD=Customer123456@

# MinIO Object Storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword
MINIO_BUCKET=product-review-media
MINIO_CHAT_BUCKET=chat-media

# MediaMTX public endpoints advertised to browsers
MEDIAMTX_WEBRTC_PUBLIC_URL=http://localhost:8889
MEDIAMTX_HLS_PUBLIC_URL=http://localhost:8888

