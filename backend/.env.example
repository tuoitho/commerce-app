# Application environment: development | production
APP_ENV=development

# HTTP port the API listens on
HTTP_PORT=18080

# PostgreSQL connection DSN
DB_URL=postgres://commerce:commerce@localhost:5432/commercesdd?sslmode=disable

# Secret used to sign access tokens (JWT). MUST be at least 32 characters.
JWT_ACCESS_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Access token lifetime (Go duration syntax, e.g. 15m, 1h, 999999h)
ACCESS_TOKEN_TTL=999999h

# Refresh token lifetime (Go duration syntax, e.g. 720h)
REFRESH_TOKEN_TTL=720h

# Whether the refresh cookie is marked Secure. Defaults to true in production,
# false otherwise. Set explicitly to override.
COOKIE_SECURE=false

# Admin bootstrap credentials
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=Admin123456@

# Structured log level: debug | info | warn | error
LOG_LEVEL=info

# MinIO S3-compatible Object Storage
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword
MINIO_BUCKET=product-review-media
MINIO_USE_SSL=false

# MoMo Payment Gateway v2 (Sandbox defaults)
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:15173/momo-return
MOMO_IPN_URL=http://localhost:18080/api/v1/payments/momo/ipn
MOMO_REQUEST_TYPE=payWithMethod
MOMO_PARTNER_NAME=Test
MOMO_STORE_ID=MomoTestStore


