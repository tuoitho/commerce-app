# Application environment: development | production
APP_ENV=development

# HTTP port the API listens on
HTTP_PORT=8080

# PostgreSQL connection DSN
DB_URL=postgres://commerce:commerce@localhost:5432/commerce?sslmode=disable

# Secret used to sign access tokens (JWT). MUST be at least 32 characters.
JWT_ACCESS_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Access token lifetime (Go duration syntax, e.g. 15m, 1h)
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime (Go duration syntax, e.g. 720h)
REFRESH_TOKEN_TTL=720h

# Whether the refresh cookie is marked Secure. Defaults to true in production,
# false otherwise. Set explicitly to override.
COOKIE_SECURE=false

# Admin bootstrap credentials
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=Admin123456@