#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.dream/sdd/<parent>-<plan-basename>/task-<N>-brief.md
# Output: absolute BRIEF_FILE and REPORT_FILE values for the controller to
# forward verbatim to the implementer.
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

to_host_path() {
  path=$1
  if grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null \
    && command -v wslpath >/dev/null 2>&1; then
    wslpath -w "$path"
  elif command -v cygpath >/dev/null 2>&1; then
    cygpath -w "$path"
  else
    printf '%s\n' "$path"
  fi
}

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

out_dir=$(cd "$(dirname "$out")" && pwd)
out="$out_dir/$(basename "$out")"
report="$out_dir/task-${n}-report.md"

awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    if (found) exit
    intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9.]|$)"))
    if (intask) found = 1
  }
  !infence && /^[ \t]*-[ \t]*\[[ xX]\][ \t]+[0-9]+(\.[0-9]+)?[. ]/ {
    if (found) exit
    line = $0
    sub(/^[ \t]*-[ \t]*\[[ xX]\][ \t]+/, "", line)
    match(line, /^[0-9]+(\.[0-9]+)?/)
    id = substr(line, RSTART, RLENGTH)
    intask = (id == n)
    if (intask) found = 1
  }
  intask { print }
' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan}" >&2
  exit 3
fi

printf 'BRIEF_FILE=%s\n' "$(to_host_path "$out")"
printf 'REPORT_FILE=%s\n' "$(to_host_path "$report")"
